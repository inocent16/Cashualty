# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Path to the SQLite database file (created automatically if missing).
# When running via docker-compose, use /app/data/cashualty.db to match the
# volume mount in docker-compose.yml, so it survives container rebuilds.
DATABASE_PATH=./cashualty.db

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: your test server's ID (enable Discord's Developer Mode, then
# right-click the server icon -> Copy Server ID). When set, slash commands
# sync instantly to this one guild instead of the ~1-hour global rollout.
# Leave blank/unset for production.
DEV_GUILD_ID=
