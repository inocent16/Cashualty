{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Cashualty",
			"type": "debugpy",
			"request": "launch",
			"module": "cashualty",
			"console": "integratedTerminal",
			"envFile": "${workspaceFolder}/.env"
		},
		{
			"name": "Run tests",
			"type": "debugpy",
			"request": "launch",
			"module": "pytest",
			"args": ["-v"],
			"console": "integratedTerminal"
		}
	]
}
